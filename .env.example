# Salin ke Vercel > Project > Settings > Environment Variables (JANGAN commit file .env asli)

# --- WAJIB ---
# Fine-grained token GitHub: repo leoganteng29/dbUbot saja, Contents: Read and write
# (boleh sama dengan github_token di config.js keybot)
GITHUB_TOKEN=
# Acak panjang, min 16 karakter. Buat: openssl rand -hex 32
SESSION_SECRET=

# --- Opsional (default sama dengan keybot/license.js) ---
GITHUB_REPO=leoganteng29/dbUbot
GITHUB_BRANCH=main
GITHUB_FILE=key.json
GITHUB_TOKENS_FILE=tokens.json
DEVELOPER_IDS=6146077243
KEY_PREFIX=LEOX
DEFAULT_DAYS=30
TIMEZONE_OFFSET=7
TIMEZONE_LABEL=WIB
BRAND=LEOX PREMIUM
SESSION_HOURS=12
# Kunci enkripsi token (Add Token). Kosong = pakai SESSION_SECRET
TOKEN_ENC_KEY=
